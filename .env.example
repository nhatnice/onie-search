DATABASE_URL=postgresql://user:password@localhost:5432/portal
REDIS_URL=redis://localhost:6379

PLAYWRIGHT_BROWSERS_PATH=./.cache/ms-playwright

# Optional — comma-separated URLs to seed via `pnpm db:seed`
SEED_URLS=

# Page crawl worker concurrency (how many pages to crawl simultaneously)
PAGE_CRAWL_WORKER_CONCURRENCY=2
