DATABASE_URL=postgresql://user:password@localhost:5432/portal
REDIS_URL=redis://localhost:6379

# Optional — comma-separated `url:type` pairs to seed via `pnpm db:seed`.
# type is one of: sitemap, rss, atom, json_feed
SEED_FEEDS=https://example.com/sitemap.xml:sitemap,https://blog.com/feed:rss,https://news.com/atom:atom

# Page crawl concurrency (how many pages to crawl simultaneously)
PAGE_CRAWL_CONCURRENCY=50

# Feed discovery worker concurrency (how many feeds to scan simultaneously)
FEED_DISCOVERY_WORKER_CONCURRENCY=4

# Cookie refresh worker concurrency (how many social cookies to refresh simultaneously)
COOKIE_REFRESH_WORKER_CONCURRENCY=4

BROWSERLESS_URL=
BROWSERLESS_TOKEN=
BROWSERLESS_TIMEOUT_MS=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288

# Exa Search API Key
EXA_API_KEY=

# OpenAI API Key for Vercel AI SDK
OPENAI_API_KEY=

# Custom Base URL for OpenAI-compatible API (optional)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model name to use (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=

UIDFB_AUTHCODE=

POST_REACT_CRAWL_CONCURRENCY=1
