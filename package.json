{
  "name": "ove",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "astryx": "node node_modules/@astryxdesign/cli/bin/astryx.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:extensions": "node --env-file-if-exists=.env --import tsx scripts/db-extensions.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/db-seed.ts",
    "feed:enqueue": "node --env-file-if-exists=.env --import tsx scripts/feed-enqueue.ts",
    "docker:run": "node --import tsx scripts/docker-build-run.ts",
    "gitnexus:analyze": "gitnexus analyze --embeddings",
    "prepare": "vp config",
    "inngest:dev": "pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.15",
    "@astryxdesign/core": "0.1.4",
    "@astryxdesign/theme-neutral": "0.1.4",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@mozilla/readability": "^0.6.0",
    "@stylexjs/stylex": "0.18.3",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-start": "1.168.27",
    "ai": "^7.0.30",
    "bullmq": "^5.80.3",
    "dayjs": "1.11.21",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eventemitter2": "^6.4.9",
    "exa-js": "^2.16.0",
    "ioredis": "^5.11.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "normalize-url": "^9.0.1",
    "pg": "^8.22.0",
    "playwright-core": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "^4.23.0",
    "turndown": "^7.2.4",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.1.4",
    "@stylexjs/unplugin": "0.18.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "6.0.3",
    "nitro": "3.0.260610-beta",
    "oxc-parser": "0.139.0",
    "oxc-transform": "0.139.0",
    "oxlint": "^1.73.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "download"
    }
  }
}
